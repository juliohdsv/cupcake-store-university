# Exemplo para ajustes opcionais. npm run dev cria .env automaticamente; NÃO colocar credenciais reais no Git.
# Dev local: API_PORT e WEB_ORIGIN para dois processos. No deploy combinado use PORT, HOST e DATABASE_PATH em disco persistente.
NODE_ENV=development
API_PORT=3333
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
DATABASE_PATH=./Model/data/cupcakes.sqlite
# No deploy combinado, não defina NEXT_PUBLIC_API_URL: a View usa /api/v1 na mesma origem.
NEXT_PUBLIC_STORE_NAME=Cupcake Store
# Acesso convidado de demonstração.
ADMIN_PASSWORD=12345678
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=12345678
# Acesso oficial: defina os dois valores apenas no .env local (nunca no Git).
OFFICIAL_ADMIN_USERNAME=
OFFICIAL_ADMIN_PASSWORD=
# Segredo aleatório forte para cookie/sessão administrativa; preencher localmente.
ADMIN_SESSION_KEY=CHANGE_ME_WITH_SECURE_RANDOM_VALUE
